# =====================================================
# Exemplo de configuracao de e-mail (SMTP)
# =====================================================
# Copie para .env (ou exporte no shell / configure no orquestrador).
# O Spring Boot NAO le .env automaticamente; em execucao local use
# export ou config/application.properties.
# NUNCA versione o arquivo .env com credenciais reais.

# --- SMTP ---
MAIL_HOST=smtp.ifrs.edu.br
MAIL_PORT=587
MAIL_USERNAME=usuario.smtp@ifrs.edu.br
MAIL_PASSWORD=troque-esta-senha
MAIL_PROTOCOL=smtp

# STARTTLS (porta 587) - deixe SSL=false
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_SSL=false

# Para SMTP com SSL direto (porta 465):
# MAIL_PORT=465
# MAIL_SMTP_STARTTLS=false
# MAIL_SMTP_STARTTLS_REQUIRED=false
# MAIL_SMTP_SSL=true

MAIL_TIMEOUT=5000

# --- Remetente e flags ---
MAIL_FROM=no-reply@hcomplementares.ifrs.edu.br
MAIL_ENABLED=true
MAIL_AVALIACAO_ALUNO_ENABLED=true
MAIL_RESUMO_PENDENCIAS_ENABLED=false

# URL publica do frontend usada nos links dos e-mails
APP_BASE_URL=https://horascomplementares.ifrs.edu.br

# Health check de e-mail no actuator (true em producao)
MAIL_HEALTH_ENABLED=false

# --- Desenvolvimento com Mailpit ---
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false
# MAIL_SMTP_SSL=false
# MAIL_ENABLED=true
# MAIL_AVALIACAO_ALUNO_ENABLED=true
# MAIL_HEALTH_ENABLED=false
