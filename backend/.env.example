# =====================================================
# Exemplo de configuração de variáveis de ambiente
# =====================================================
# Copie para .env (ou exporte no shell).
# NUNCA versione o arquivo .env com credenciais reais.

# ==================== BANCO DE DADOS ====================
POSTGRES_DB=sifrac
POSTGRES_USER=sifrac
POSTGRES_PASSWORD=sua_senha_segura

# ==================== LDAP (IFRS) ====================
# Production: LDAP do IFRS
LDAP_URL=ldap://ldap.ifrs.edu.br:389
LDAP_BASE_DN=dc=ifrs,dc=edu,dc=br
LDAP_BIND_DN=cn=admin,dc=ifrs,dc=edu,dc=br
LDAP_BIND_PASSWORD=sua_senha_ldap

# ==================== E-MAIL (SMTP) ====================
# Exemplo com Gmail - use conta institucional ou serviço configurado
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua_senha_app

# --- Desenvolvimento com Mailpit ---
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
